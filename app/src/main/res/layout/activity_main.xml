<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top"
        android:padding="24dp"
        android:background="@color/black">

    <!-- App title -->
    <TextView android:id="@+id/appTitle"
              android:text="@string/app_name"
              android:layout_gravity="top"
              android:layout_marginTop="0dp"
              android:layout_marginBottom="20dp"
              android:paddingTop="0dp"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:textColor="@color/white"/>
    <!-- col display -->
    <LinearLayout android:layout_width="match_parent"
                  android:layout_height="match_parent"
                  android:orientation="vertical">
        <!-- initial config -->
        <LinearLayout style="@style/MainColumnContainerStyle">
            <!-- Timer config -->
            <TextView
                    android:id="@+id/round_time_text"
                    style="@style/MainColumnStyle"
                    android:text="@string/round_time"
                    android:textSize="15sp"
                    android:textColor="@color/white"/>
            <!-- timer text -->
            <TextView
                    android:id="@+id/time_text"
                    style="@style/MainColumnStyle"
                    android:text="@string/timer_default"
                    android:textSize="35sp"
                    android:textColor="@color/white"/>
            <!-- + - Buttons -->
            <include android:id="@+id/control_round"
                     style="@style/MainColumnStyle"
                     layout="@layout/timer_controls"/>
        </LinearLayout>
        <LinearLayout style="@style/MainColumnContainerStyle">
            <!-- Rest timer -->
            <TextView
                    android:id="@+id/rest_time_text"
                    style="@style/MainColumnStyle"
                    android:text="@string/rest_time_text"
                    android:textSize="15sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/white"/>
            <!-- Rest timer text-->
            <TextView
                    android:id="@+id/rest_time"
                    style="@style/MainColumnStyle"
                    android:text="@string/rest_time_default"
                    android:textSize="35sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/white"/>
            <!-- + - Buttons -->
            <include android:id="@+id/control_rest"
                     layout="@layout/timer_controls"/>
        </LinearLayout>
        <LinearLayout style="@style/MainColumnContainerStyle">
            <TextView
                    android:id="@+id/num_rounds_text"
                    style="@style/MainColumnStyle"
                    android:text="@string/num_rounds_text"
                    android:textSize="15sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/white"/>
            <TextView
                    android:id="@+id/num_rounds"
                    style="@style/MainColumnStyle"
                    android:text="@string/num_rounds_default"
                    android:textSize="35sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/white"/>
            <!-- + - Buttons -->
            <include android:id="@+id/control_number_rounds"
                     layout="@layout/timer_controls"/>
        </LinearLayout>

        <LinearLayout
                android:orientation="horizontal"
                android:layout_width="230dp"
                android:layout_gravity="center"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="10dp">
            <!-- start button -->
            <Button
                    android:id="@+id/start_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/start"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/purple"
            />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>