<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top"
        android:padding="24dp"
        android:background="@color/bg_dark">

    <!-- App title -->
    <TextView
            android:text="@string/app_name"
            android:layout_gravity="top"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="20dp"
            android:paddingTop="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/appTitle"/>
    <!-- initial config -->
    <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
        <LinearLayout android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:paddingStart="10dp"
                      android:paddingEnd="0dp">
            <!-- Timer config -->
            <TextView
                    android:id="@+id/roundTimeText"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:padding="10dp"
                    android:text="@string/round_time"
                    android:textSize="15sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/white"/>
            <!-- timer text -->
            <TextView
                    android:id="@+id/timeText"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/timer_default"
                    android:textSize="35sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/white"/>
            <!-- + - Buttons -->
            <include android:id="@+id/control_round"
            layout="@layout/timer_controls"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:padding="10dp">
            <!-- Rest timer -->
            <TextView
                    android:id="@+id/rest_time_text"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:padding="10dp"
                    android:text="@string/rest_time_text"
                    android:textSize="15sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/white"/>
            <!-- Rest timer text-->
            <TextView
                    android:id="@+id/rest_time"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/rest_time_default"
                    android:textSize="35sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/white"/>
            <!-- + - Buttons -->
            <include android:id="@+id/control_rest"
                    layout="@layout/timer_controls"/>
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:padding="10dp">
            <TextView
                    android:id="@+id/numRoundsText"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:padding="10dp"
                    android:text="@string/num_rounds_text"
                    android:textSize="15sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/white"/>
            <TextView
                    android:id="@+id/numRounds"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/num_rounds_default"
                    android:textSize="35sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/white"/>
            <!-- + - Buttons -->
            <include android:id="@+id/control_number_rounds"
                    layout="@layout/timer_controls"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
        <!-- start button -->
        <Button
                android:id="@+id/startButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/start"
                app:backgroundTint="@color/brand"
                 />
    </LinearLayout>
</LinearLayout>