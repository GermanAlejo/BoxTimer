<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top"
        android:padding="24dp"
        android:background="@color/black">

    <!-- App title -->
    <include android:id="@+id/app_title_container"
             layout="@layout/app_title"/>
    <!-- col display -->
    <LinearLayout android:layout_width="match_parent"
                  android:layout_height="match_parent"
                  android:orientation="vertical">
        <!-- Total Training time -->
        <LinearLayout style="@style/MainColumnContainerStyle">
            <TextView android:id="@+id/total_time_text"
                      style="@style/MainColumnStyle"
                      android:text="@string/training_time_text"
                      android:textSize="15sp"/>
            <TextView
                    android:id="@+id/total_time"
                    style="@style/MainColumnStyle"
                    android:text="@string/timer_default"
                    android:textSize="35sp"/>
        </LinearLayout>
        <!-- initial config -->
        <LinearLayout style="@style/MainColumnContainerStyle">
            <!-- Timer config -->
            <TextView
                    android:id="@+id/round_time_text"
                    style="@style/MainColumnStyle"
                    android:text="@string/round_time"
                    android:textSize="15sp"/>
            <!-- timer text -->
            <TextView
                    android:id="@+id/time_text"
                    style="@style/MainColumnStyle"
                    android:text="@string/timer_default"
                    android:textSize="25sp"
                    android:focusable="false"
                    android:inputType="none"/>
            <!-- + - Buttons -->
            <include android:id="@+id/control_round"
                     style="@style/MainColumnStyle"
                     layout="@layout/timer_controls"/>
        </LinearLayout>
        <LinearLayout style="@style/MainColumnContainerStyle">
            <!-- Rest timer -->
            <TextView
                    android:id="@+id/rest_time_text"
                    style="@style/MainColumnStyle"
                    android:text="@string/rest_time_text"
                    android:textSize="15sp"/>
            <!-- Rest timer text-->
            <TextView
                    android:id="@+id/rest_time"
                    style="@style/MainColumnStyle"
                    android:text="@string/rest_time_default"
                    android:textSize="25sp"
                    android:focusable="false"
                    android:inputType="none"/>
            <!-- + - Buttons -->
            <include android:id="@+id/control_rest"
                     style="@style/MainColumnStyle"
                     layout="@layout/timer_controls"/>
        </LinearLayout>
        <LinearLayout style="@style/MainColumnContainerStyle">
            <TextView
                    android:id="@+id/num_rounds_text"
                    style="@style/MainColumnStyle"
                    android:text="@string/num_rounds_text"
                    android:textSize="15sp"/>
            <TextView
                    android:id="@+id/num_rounds"
                    style="@style/MainColumnStyle"
                    android:text="@string/num_rounds_default"
                    android:textSize="25sp"
                    android:focusable="false"
                    android:inputType="none"/>
            <!-- + - Buttons -->
            <include android:id="@+id/control_number_rounds"
                     style="@style/MainColumnStyle"
                     layout="@layout/timer_controls"/>
        </LinearLayout>

        <LinearLayout
                android:orientation="horizontal"
                android:layout_width="230dp"
                android:layout_gravity="center"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="100dp">
            <!-- start button -->
            <Button
                    android:id="@+id/start_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/start"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/green"
            />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>