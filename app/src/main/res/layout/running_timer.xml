<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="top"
        android:padding="24dp"
        android:background="@color/black">

    <!-- App title -->
    <include android:id="@+id/app_title_container"
             layout="@layout/app_title"/>

    <!-- col display -->
    <LinearLayout android:layout_width="match_parent"
                  android:layout_height="0dp"
                  android:orientation="horizontal"
                  android:layout_weight="2">
        <!-- Round Number -->
        <LinearLayout style="@style/RoundContainerStyle">
            <TextView android:id="@+id/rounds_left_text"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_gravity="center"
                      android:text="@string/rounds"
                      android:textSize="20sp"
                      android:fontFamily="monospace"
                      android:textColor="@color/white"/>
            <TextView
                    android:id="@+id/rounds_left"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/roundsLeftDefault"
                    android:textSize="52sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/white"/>
        </LinearLayout>
    </LinearLayout>


    <!-- col display -->
    <LinearLayout android:layout_width="match_parent"
                  android:layout_height="0dp"
                  android:orientation="vertical"
                  android:layout_gravity="top"
                  android:layout_weight="10">
        <!-- Rest timer by default hidden -->
        <LinearLayout android:id="@+id/rest_time_container"
                      style="@style/RunningTimerContainerStyle"
                      android:visibility="gone">
            <TextView android:id="@+id/rest_timer_left_text"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_gravity="center"
                      android:text="@string/rest_left"
                      android:textSize="38sp"
                      android:fontFamily="monospace"
                      android:textColor="@color/white"/>
            <TextView
                    android:id="@+id/rest_timer_left"
                    android:layout_gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/timer_default"
                    android:textSize="92sp"
                    android:fontFamily="monospace"
                    android:textColor="@color/white"/>
        </LinearLayout>

        <!-- Time display -->
        <LinearLayout android:id="@+id/running_timer_container"
                      style="@style/RunningTimerContainerStyle">
            <TextView android:id="@+id/time_left_text"
                      android:padding="20sp"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:layout_gravity="top"
                      android:maxLines="1"
                      android:text="@string/time_left"
                      android:textSize="38sp"
                      android:fontFamily="monospace"
                      android:textColor="@color/white"/>
            <TextView android:id="@+id/time_left"
                      android:layout_gravity="center_horizontal"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:gravity="center"
                      android:text="@string/timer_default"
                      android:textSize="92sp"
                      android:fontFamily="monospace"
                      android:textColor="@color/white"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Control buttons -->
    <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_gravity="bottom"
            android:layout_marginTop="32dp"
            android:layout_weight="2">
        <Button android:id="@+id/start_button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/start"
                android:textColor="@color/white"
                app:backgroundTint="@color/green"/>
        <Button android:id="@+id/pause_button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/pause"
                android:visibility="gone"
                android:textColor="@color/black"
                app:backgroundTint="@color/yellow"/>
        <Button android:id="@+id/reset_button"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:backgroundTint="@color/red"
                android:text="@string/reset"/>
    </LinearLayout>
</LinearLayout>